{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devradar",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Tắt workers.dev; trang điều khiển truy cập qua domain riêng (gắn trong dashboard). Domain đó phải nằm sau Cloudflare Access: code không có auth.
  "workers_dev": false,
  "preview_urls": false,
  // Chạy fetch handler (trang web) gần D1 ở APAC. Không ảnh hưởng cron.
  "placement": { "region": "aws:ap-southeast-1" },
  // Địa chỉ trang điều khiển (sau Cloudflare Access), dùng cho nút "Bản lưu" trong card Google Chat.
  "vars": { "SITE_URL": "https://feed.phuchien.me" },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devradar-history",
      "database_id": "c3e09a62-fbf1-453e-8d29-db6d0577737e"
    }
  ]
}
