{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devradar",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // workers.dev bật để gọi POST /run. Bảo vệ bằng Cloudflare Access (đăng nhập), không có auth trong code; preview URLs vẫn tắt
  "workers_dev": true,
  "preview_urls": false,
  // Chạy fetch handler (trang web) gần D1 ở APAC. Không ảnh hưởng cron.
  "placement": { "region": "aws:ap-southeast-1" },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devradar-history",
      "database_id": "c3e09a62-fbf1-453e-8d29-db6d0577737e"
    }
  ]
}
