{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devradar",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // workers.dev bật để gọi POST /run. Bảo vệ bằng Cloudflare Access (đăng nhập), không có auth trong code; preview URLs vẫn tắt
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "TELEGRAM_CHAT_ID": "7369396966"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "0cade1f069934a0ea262fb9f9974d98a"
    }
  ]
}
